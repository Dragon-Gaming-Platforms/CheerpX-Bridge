{
  "name": "dragon86-hoster",
  "version": "1.0.0",
  "private": true,
  "description": "Dragon86 Hoster — headless CheerpX engine page driven by the Dragon86 web OS over a postMessage bridge (protocol v1).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/bridge.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bridge-test.mjs && node node_modules/.cache/bridge-test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
